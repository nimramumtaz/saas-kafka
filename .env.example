PORT=3000
JWT_SECRET=change-me-in-production

# ---------- DATABASE ----------
# LOCAL (docker):  postgres://app_user:app_pass@localhost:5432/saas
# CLOUD (Neon):    postgresql://app_user:app_pass@<your-neon-host>/<dbname>?sslmode=require
DATABASE_URL=postgres://app_user:app_pass@localhost:5432/saas
# Admin/owner connection string from Neon (used only by seed + benchmark)
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas
PG_SSL=false          # set true for Neon / Aiven / Supabase
PG_POOL_MAX=20

# ---------- KAFKA ----------
# LOCAL (docker redpanda): KAFKA_BROKERS=localhost:9092
# CLOUD (Aiven): KAFKA_BROKERS=<host>:<port>  + the 3 cert files below
KAFKA_BROKERS=localhost:9092
KAFKA_SSL=false
KAFKA_CA_PATH=
KAFKA_CERT_PATH=
KAFKA_KEY_PATH=
# (or SASL style providers)
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_TOPIC=tenant.orders
KAFKA_GROUP_ID=order-processors

RUN_CONSUMER=false
INVOICE_FUNCTION_URL=http://localhost:3000/api/invoice
